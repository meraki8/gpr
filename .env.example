# ----- Database (Railway PostgreSQL) -----
# Copy DATABASE_PUBLIC_URL from Railway → Postgres service → Variables
DATABASE_URL=

# ----- Clerk auth -----
# clerk.com → app → API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard

# ----- OpenAI (GPT-5.4 Mini default) -----
# platform.openai.com → API keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini

# ----- Vercel Blob (file storage, used in phase 4) -----
# vercel.com → Storage → Create Blob store → tokens
BLOB_READ_WRITE_TOKEN=

# ----- Resend (transactional email, used in phase 3) -----
# resend.com → API Keys
RESEND_API_KEY=
# Default sender. In demo mode (RESEND_DOMAIN unset) we hard-pin to
# onboarding@resend.dev because Resend rejects external recipients
# without a verified sender domain.
RESEND_FROM_EMAIL="GPR <onboarding@resend.dev>"
# Set this to your verified sending domain (e.g. mail.gpr.app) once
# DNS is configured in Resend. While empty, every outgoing email is
# redirected to DEMO_EMAIL instead of the real recipient.
RESEND_DOMAIN=
# Catch-all inbox used while RESEND_DOMAIN is empty. Lets you demo
# the full invite flow without verifying a domain.
DEMO_EMAIL=

# ----- App -----
NEXT_PUBLIC_APP_URL=http://localhost:3000
