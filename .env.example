# ----- Database (Railway PostgreSQL) -----
# Copy DATABASE_PUBLIC_URL from Railway → Postgres service → Variables
DATABASE_URL=

# ----- Clerk auth -----
# clerk.com → app → API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard

# ----- OpenAI (GPT-5.4 Mini default) -----
# platform.openai.com → API keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini

# ----- Vercel Blob (file storage, used in phase 4) -----
# vercel.com → Storage → Create Blob store → tokens
BLOB_READ_WRITE_TOKEN=

# ----- Resend (transactional email, used in phase 3) -----
# resend.com → API Keys
RESEND_API_KEY=
RESEND_FROM_EMAIL="GPR <noreply@yourdomain.com>"

# ----- App -----
NEXT_PUBLIC_APP_URL=http://localhost:3000
